# Copie para .env e preencha localmente. Nunca commitar o .env de verdade.

# Envio do formulário de contato (obrigatório em produção)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=contato@inovai.com.br
CONTATO_DESTINO=contato@inovai.com.br

# Banco (opcional): sem isto, o contato é registrado só por e-mail
# DATABASE_URL=postgresql://...
